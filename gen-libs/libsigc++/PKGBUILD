# description	: Typesafe callback system for standard C++
# depends	: libxslt m4

pkgname=libsigc++
_pkgname=libsigc++
pkgver=2.12.1
pkgrel=1
source=(https://download.gnome.org/sources/libsigc++/${pkgver%.*}/${_pkgname}-$pkgver.tar.xz)

build() {
	cd ${_pkgname}-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        bld
	ninja -C bld
}

package() {
    cd ${_pkgname}-$pkgver

	DESTDIR="$pkgdir" ninja -C bld install
}