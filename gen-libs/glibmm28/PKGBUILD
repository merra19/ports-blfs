# description	: C++ interface for glib2
# depends	: glib libsigc++3

pkgname=glibmm28
_pkgname=glibmm
pkgver=2.84.0
pkgrel=1
source=(https://download.gnome.org/sources/glibmm/${pkgver%.*}/${_pkgname}-$pkgver.tar.xz)

build() {
	cd ${_pkgname}-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        bld
	ninja -C bld
}

package() {
    cd ${_pkgname}-$pkgver

    DESTDIR="$pkgdir" ninja -C bld  install
}
