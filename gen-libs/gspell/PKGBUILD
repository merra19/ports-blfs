# description	: Spell check library for GTK+ applications"
# depends	: glib gobject-introspection gtk3 icu meson enchant

pkgname=gspell
pkgver=1.14.0
pkgrel=1
source=(https://download.gnome.org/sources/gspell/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D gtk_doc=false \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

	DESTDIR="$pkgdir" ninja -C build install
}