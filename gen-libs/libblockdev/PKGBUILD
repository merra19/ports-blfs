# description	: A library for manipulating block devices
# depends	:  gobject-introspection libbytesize libnvme parted  
# depends	: libyaml cryptsetup glib gptfdisk kmod util-linux   
# depends	: lvm2 udev py3-gobject3 keyutils json-glib smartmontools
# todo      : escrow!!nss escrow!!volume_key 

pkgname=libblockdev
pkgver=3.3.1
pkgrel=1
options=(!lto)
source=(https://github.com/storaged-project/libblockdev/releases/download/$pkgver/$pkgname-$pkgver.tar.gz)

build() {
	cd $pkgname-$pkgver

	./configure \
        --prefix=/usr \
		--sysconfdir=/etc \
		--with-python3 \
		--without-escrow \
		--without-gtk-doc \
		--without-nvdimm \
		--with-tools \
		--with-smartmontools
	make
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" install
}