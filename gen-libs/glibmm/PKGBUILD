# description	: C++ interface for glib2
# depends	: glib libsigc++

pkgname=glibmm
pkgver=2.66.8
pkgrel=1
source=(https://download.gnome.org/sources/glibmm/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        bld
	ninja -C bld
}

package() {
    cd $pkgname-$pkgver

    DESTDIR="$pkgdir" ninja -C bld  install
}
