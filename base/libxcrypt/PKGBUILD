# description	: Extended crypt library for descrypt, md5crypt, bcrypt, and others
# depends	: glibc pkgconf

pkgname=libxcrypt
pkgver=4.4.38
pkgrel=1
source=(https://github.com/besser82/libxcrypt/releases/download/v$pkgver/libxcrypt-$pkgver.tar.xz)

prepare() {
    mkdir $pkgname-$pkgver/{build,build2}
}

build() {
    cd $pkgname-$pkgver

    cd build

    ../configure \
        --prefix=/usr \
        --disable-werror \
        --enable-hashes=strong,glibc \
        --enable-obsolete-api=no \
        --disable-static \
        --disable-failure-tokens
    make

    cd ../build2

    ../configure \
        --prefix=/usr \
        --enable-hashes=strong,glibc \
        --enable-obsolete-api=glibc \
        --disable-static \
        --disable-failure-tokens
    make
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" install -C build
    cp -av --remove-destination build2/.libs/libcrypt.so.1* "$pkgdir"/usr/lib
}
