# description	: A shared library tool for developers
# depends	: glibc

pkgname=libtool
pkgver=2.5.4
pkgrel=1
source=(https://ftp.gnu.org/gnu/libtool/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr
    make
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" install

    ## Remove excluded files
    rm -f "$pkgdir"/usr/lib/libltdl.a
}
