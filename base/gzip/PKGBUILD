# description	: Standard GNU compressor
# depends	: glibc less

pkgname=gzip
pkgver=1.14
pkgrel=1
source=(https://ftp.gnu.org/gnu/gzip/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr
    make
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" install
}
