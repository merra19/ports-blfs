# description	: A Client that groks URL
# depends	: p11-kit openssl zlib zstd perl nghttp2 libpsl c-ares 
# depends	: dbus libidn2
# optional	: krb5!!openldap

pkgname=curl
pkgver=8.15.0
pkgrel=1
options=(!lto)
source=(https://curl.se/download/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

    scratch isinstalled openldap && OPT_LDAP='--with-gssapi' ||  OPT_LDAP='--disable-ldap'

    ./configure \
        --prefix=/usr \
        --disable-static \
		--enable-ares \
		--enable-ipv6 \
		--with-libidn2 \
		--with-nghttp2 \
		--with-openssl \
		--with-zsh-functions-dir \
		--with-fish-functions-dir \
		--with-pic \
        --with-ca-path=/etc/ssl/certs \
        $OPT_LDAP
    make
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" install
}