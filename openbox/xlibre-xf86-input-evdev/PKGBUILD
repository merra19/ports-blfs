# description	: Generic Linux input driver
# depends	: libevdev mtdev xorg-proto linux-api-headers udev
# depends	: udev

pkgname=xlibre-xf86-input-evdev
pkgver=2.11.0.1
pkgrel=2
options=(!makeflags)
source=(https://github.com/X11Libre/xf86-input-evdev/archive/refs/tags/$pkgname-$pkgver.tar.gz)

build() {
    cd xf86-input-evdev-xlibre-xf86-input-evdev-$pkgver

    LDFLAGS=" -Wl,-O1 -Wl,--sort-common -Wl,--as-needed -Wl,-z,lazy -Wl,-z,relro -Wl,-z,pack-relative-relocs -Wl,-z,now"
    export LDFLAGS

    autoreconf -fiv
    
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static
    make -j1
}

package() {
    cd xf86-input-evdev-xlibre-xf86-input-evdev-$pkgver

    make DESTDIR="$pkgdir" install
}