# description	: Media player and framework with support for most multimedia files and streaming
# depends	: yasm wayland libvorbis libidn zlib mesa alsa-lib libaom 
# depends	: libarchive dav1d dbus ffmpeg flac libogg fontconfig udev
# depends	: libjpeg-turbo libsamplerate lua liba52 mpg123 qt5 speex
# depends	: ncurses opus libpng pulseaudio libssh2 xorg-libs libva
# depends	: speexdsp gnutls freetype ttf-dejavu wayland-protocols 
# depends	: libxcb xcb-util xcb-utilities x265 libmad avahi libvpx
# depends	: libxml2 fribidi harfbuzz liberation-fonts fdk-aac cairo
# depends	: libgcrypt libass glib gdk-pixbuf gtk3 librsvg taglib
# depends	: libvdpau  
# optional	: cddb!!libcddb dvd!!libdvdnav dvd!!libdvdread faad!faad2 
# optional	: gstreamer!!gst-plugins-base libnotify!!libnotify
# optional	: keyring!!libsecret 

pkgname=vlc
pkgver=3.0.21
pkgrel=1
source=(https://download.videolan.org/vlc/$pkgver/$pkgname-$pkgver.tar.xz
        https://www.linuxfromscratch.org/patches/blfs/svn/vlc-$pkgver-taglib-1.patch
        https://www.linuxfromscratch.org/patches/blfs/svn/vlc-$pkgver-fedora_ffmpeg7-1.patch)

build() {
    cd $pkgname-$pkgver

    patch -Np1 -i ../vlc-$pkgver-taglib-1.patch 
    patch -Np1 -i ../vlc-$pkgver-fedora_ffmpeg7-1.patch

    BUILDCC=gcc ./configure \
        --prefix=/usr \
        --disable-libplacebo \
        --enable-qt
    make
    make  docdir=/usr/share/doc/$pkgname-$pkgver DESTDIR="$pkgdir" install
}