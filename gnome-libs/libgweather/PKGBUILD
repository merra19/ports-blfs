# description	: Location and timezone database and weather-lookup library
# depends	: glib gobject-introspection json-glib libxml2 libsoup2 
# depends	: meson vala geocode-glib py3-gobject3

pkgname=libgweather
pkgver=4.4.4
pkgrel=1
source=(https://download.gnome.org/sources/$pkgname/${pkgver%.*}/$pkgname-$pkgver.tar.xz
        https://www.linuxfromscratch.org/patches/blfs/svn/libgweather-4.4.4-upstream_fix-1.patch)

build() {
	cd $pkgname-$pkgver

    patch -Np1 -i ../libgweather-4.4.4-upstream_fix-1.patch

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D gtk_doc=false \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

    DESTDIR="$pkgdir" ninja -C build install
}