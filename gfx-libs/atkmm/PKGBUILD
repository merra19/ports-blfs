# description	: C++ interface for the ATK library
# depends	: at-spi2-core glibmm libsigc++

pkgname=atkmm
pkgver=2.28.4
pkgrel=1
source=(https://download.gnome.org/sources/atkmm/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

    DESTDIR="$pkgdir" ninja -C build install
}
