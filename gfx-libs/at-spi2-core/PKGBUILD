# description	: D-Bus accessibility specifications and registration daemon
# depends	: dbus glib libxml2 gobject-introspection libx11 libxtst 
# depends	: libxi

pkgname=at-spi2-core
pkgver=2.56.4
pkgrel=1
source=(https://download.gnome.org/sources/at-spi2-core/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D systemd_user_dir=/tmp \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

	DESTDIR="$pkgdir" ninja -C build install

    rm -rf "$pkgdir"/tmp
}
