# description	: C++ interface for pango
# depends	: cairomm116 glibmm28 pango libsigc++3

pkgname=pangomm254
_pkgname=pangomm
pkgver=2.56.1
pkgrel=1
source=(https://download.gnome.org/sources/pangomm/${pkgver%.*}/${_pkgname}-$pkgver.tar.xz)

build() {
	cd ${_pkgname}-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build
	ninja -C build
}

package() {
    cd ${_pkgname}-$pkgver

    DESTDIR="$pkgdir" ninja -C build install
}
