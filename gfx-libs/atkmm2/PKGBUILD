# description	: C++ interface for the ATK library
# depends	: at-spi2-core glibmm28 libsigc++3

pkgname=atkmm2
_pkgname=atkmm
pkgver=2.36.3
pkgrel=1
source=(https://download.gnome.org/sources/atkmm/${pkgver%.*}/${_pkgname}-$pkgver.tar.xz)

build() {
	cd ${_pkgname}-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build
	ninja -C build
}

package() {
    cd ${_pkgname}-$pkgver

    DESTDIR="$pkgdir" ninja -C build install
}
