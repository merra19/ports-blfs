# description	: X.Org libdrm library
# depends	: meson libxslt libpciaccess

pkgname=libdrm
pkgver=2.4.125
pkgrel=1
source=(https://dri.freedesktop.org/libdrm/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D udev=true \
        -D valgrind=disabled \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

    DESTDIR="$pkgdir" ninja -C build install
}