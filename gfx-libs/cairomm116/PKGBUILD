# description	: C++ bindings for the Cairo vector graphics library
# depends	: cairo libsigc++3 boost

pkgname=cairomm116
_pkgname=cairomm
pkgver=1.18.0
pkgrel=1
source=(https://www.cairographics.org/releases/cairomm-$pkgver.tar.xz)

build() {
	cd ${_pkgname}-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
		-D build-tests=true \
		-D boost-shared=true \
        build
	ninja -C build
}

package() {
    cd ${_pkgname}-$pkgver

    DESTDIR="$pkgdir" ninja -C build install
}
