# description	: The OpenGL Utility Library
# depends	: libglvnd

pkgname=glu
pkgver=9.0.3
pkgrel=1
source=(ftp://ftp.freedesktop.org/pub/mesa/glu/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D gl_provider=gl \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

	DESTDIR="$pkgdir" ninja -C build install
	rm -vf "$pkgdir"/usr/lib/libGLU.a
}
