# description	: Qt module containing the unsupported Qt 5 APIs
# depends	: qt6-base qt6-declarative qt6-shadertools python3 
# depends	: vulkan-headers 

pkgname=qt6-5compat
pkgver=6.9.1
pkgrel=1
source=(https://download.qt.io/official_releases/qt/${pkgver%.*}/$pkgver/submodules/qt5compat-everywhere-src-$pkgver.tar.xz)

build() {
    cd qt5compat-everywhere-src-$pkgver

    cmake -B build -G Ninja \
        -D CMAKE_MESSAGE_LOG_LEVEL=STATUS
    cmake --build build
}

package() {
    cd qt5compat-everywhere-src-$pkgver

    DESTDIR="$pkgdir" cmake --install build
}