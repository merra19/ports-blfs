# description	: C++ interface for GTK+
# depends	: atkmm2 gtk4 pangomm254 cairomm116 glibmm28 libsigc++3 
# depends	: libepoxy gdk-pixbuf

pkgname=gtkmm4
_pkgname=gtkmm
pkgver=4.18.0 
pkgrel=1
source=(https://download.gnome.org/sources/gtkmm/${pkgver%.*}/${_pkgname}-$pkgver.tar.xz)

build() {
	cd ${_pkgname}-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        gtkmm4-build
	ninja -C gtkmm4-build
}

package() {
    cd ${_pkgname}-$pkgver

    DESTDIR="$pkgdir" ninja -C gtkmm4-build install
}
