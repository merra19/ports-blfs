# description	: Building blocks for modern GNOME applications
# depends	: glib gobject-introspection gtk4 appstream fribidi vala
# depends	: xorg-proto sassc

pkgname=libadwaita
pkgver=1.7.6
pkgrel=1
source=(https://download.gnome.org/sources/libadwaita/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

    DESTDIR="$pkgdir" ninja -C build install
}