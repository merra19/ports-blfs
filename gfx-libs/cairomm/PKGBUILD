# description	: C++ bindings for the Cairo vector graphics library
# depends	: cairo libsigc++

pkgname=cairomm
pkgver=1.14.5
pkgrel=1
source=(https://www.cairographics.org/releases/cairomm-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
		-D build-tests=true \
		-D boost-shared=true \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

    DESTDIR="$pkgdir" ninja -C build install
}
