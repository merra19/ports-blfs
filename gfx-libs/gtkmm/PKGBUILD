# description	: C++ interface for GTK+
# depends	: atkmm gtk3 pangomm cairomm glibmm libsigc++ libepoxy 
# depends	: gdk-pixbuf

pkgname=gtkmm
pkgver=3.24.10
pkgrel=1
source=(https://download.gnome.org/sources/gtkmm/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        gtkmm3-build
	ninja -C gtkmm3-build
}

package() {
    cd $pkgname-$pkgver

    DESTDIR="$pkgdir" ninja -C gtkmm3-build install
}
