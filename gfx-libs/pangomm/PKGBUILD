# description	: C++ interface for pango
# depends	: cairomm glibmm pango libsigc++

pkgname=pangomm
pkgver=2.46.4
pkgrel=1
source=(https://download.gnome.org/sources/pangomm/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

    DESTDIR="$pkgdir" ninja -C build install
}
