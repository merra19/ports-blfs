# description	: Desktop integration portal
# depends	: json-glib wireplumber pipewire fuse gdk-pixbuf 
# depends	: bubblewrap dbus geoclue libportal

pkgname=xdg-desktop-portal
pkgver=1.20.3
pkgrel=1
options=(!lto)
source=(https://github.com/flatpak/xdg-desktop-portal/releases/download/$pkgver/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D tests=disabled \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

	DESTDIR="$pkgdir" ninja -C build install

    rm -rf "$pkgdir"/usr/lib/systemd
}