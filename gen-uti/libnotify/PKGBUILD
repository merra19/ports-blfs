# description	: A library for sending desktop notifications
# depends	: glib gobject-introspection gdk-pixbuf docbook-xml 
# depends	: libxslt

pkgname=libnotify
pkgver=0.8.4
pkgrel=1
source=(https://download.gnome.org/sources/libnotify/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D gtk_doc=false \
        -D man=false \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

    DESTDIR="$pkgdir" ninja -C build install

    mv "$pkgdir"/usr/share/doc/libnotify{,-$pkgver}
}
