# description	: Linux-PAM (Pluggable Authentication Modules)
# depends	: flex bison libxcrypt autoconf automake meson ninja 
# depends	: docbook-xsl-ns libnsl libtirpc rpcsvc-proto

pkgname=pam
pkgver=1.7.1
pkgrel=1
source=(https://github.com/linux-pam/linux-pam/releases/download/v$pkgver/Linux-PAM-$pkgver.tar.xz
        https://anduin.linuxfromscratch.org/BLFS/Linux-PAM/Linux-PAM-$pkgver-docs.tar.xz
	    system-account system-auth system-session system-password other system-password2)
backup=(etc/security/access.conf etc/security/faillock.conf etc/security/group.conf etc/security/limits.conf etc/security/namespace.conf 
        etc/security/namespace.init etc/security/pwhistory.conf etc/security/pam_env.conf etc/security/time.conf etc/environment)
noextract=(Linux-PAM-$pkgver-docs.tar.xz)

build() {
    cd Linux-PAM-$pkgver

    tar -xf ../Linux-PAM-$pkgver-docs.tar.xz --strip-components=1

    meson setup \
        --prefix=/usr \
        --buildtype=plain \
		-D docdir=/usr/share/doc/Linux-PAM-$pkgver \
        build
    ninja -C build
}

package() {
    cd Linux-PAM-$pkgver

    mkdir -p "$pkgdir"/etc/pam.d

    DESTDIR="$pkgdir" ninja -C build install

    tar -C "$pkgdir" -xvf "$srcdir"/Linux-PAM-$pkgver-docs.tar.xz

    rm -rf "$pkgdir"/usr/lib/systemd

	# install our pam.d files
    cd "$srcdir"
    
    install -m 0644 system-account system-auth system-session system-password other "$pkgdir"/etc/pam.d/

    if ( scratch isinstalled libpwquality ); then  
        cp system-password2  "$pkgdir"/etc/pam.d/system-password 
    fi
}
