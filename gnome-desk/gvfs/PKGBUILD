# description	: Virtual filesystem implementation for GIO
# depends	: glib gsettings-desktop-schemas dbus gcr4 polkit libcap 
# depends	: libarchive libgudev udev fuse udisks2 openssh libxslt
# depends	: libgcrypt libusb libsecret libxml2 elogind avahi
# optional	: cdda!!libcdio cdda!!libcdio-paranoia http!!libsoup3
# optional	: google!!libgdata
# todo      : libmtp

pkgname=gvfs
pkgver=1.56.1
pkgrel=1
source=(https://download.gnome.org/sources/gvfs/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D onedrive=false \
        -D fuse=false \
        -D gphoto2=false \
        -D afc=false \
        -D bluray=false \
        -D nfs=false \
        -D mtp=false \
        -D smb=false \
        -D tmpfilesdir=no \
        -D dnssd=false \
        -D goa=false \
        -D google=false \
        -D cdda=false \
        -D systemduserunitdir=no \
        -D http="$(scratch isinstalled libsoup3 && echo "true" || echo "false")" \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

    DESTDIR="$pkgdir" ninja -C build install
}
