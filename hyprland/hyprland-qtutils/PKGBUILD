# description	: Hyprland QT/qml utility apps
# depends	:  hyprland-qt-support hyprutils qt6-base qt6-declarative
# depends	:  qt6-wayland cmake

pkgname=hyprland-qtutils
pkgver=0.1.3
pkgrel=1
source=($pkgname-$pkgver.tar.gz::https://github.com/hyprwm/$pkgname/archive/refs/tags/v$pkgver.tar.gz)

build() {
	cd $pkgname-$pkgver

	cmake -B build \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_BUILD_TYPE=Release
	cmake --build build
}

package() {
    cd $pkgname-$pkgver

    DESTDIR="$pkgdir" cmake --install build
}