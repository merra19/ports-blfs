# description	: Framework providing desktop-wide storage for passwords
# depends	: qt6-base qt6-tools extra-cmake-modules gpgme kconfig
# depends	: kcolorscheme kcrash kcoreaddons kdbusaddons ki18n 
# depends	: knotifications kservice kwidgetsaddons kwindowsystem 
# depends	: libgcrypt qca kdoctools

pkgname=kwallet
pkgver=6.11.0
pkgrel=1
source=(https://download.kde.org/stable/frameworks/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

    cmake -B build \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_LIBEXECDIR=libexec \
        -D CMAKE_PREFIX_PATH=/usr \
        -D CMAKE_SKIP_INSTALL_RPATH=ON  \
        -D CMAKE_BUILD_TYPE=Release \
        -D BUILD_TESTING=OFF \
        -Wno-dev
    make -C build
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" -C build install
}
