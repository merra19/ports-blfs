# description	: D-Bus abstraction for enumerating power devices, querying history and statistics
# depends	: libgudev gobject-introspection meson glib dbus libxslt
# depends	: py3-gobject3 docbook-xsl-nons

pkgname=upower
pkgver=1.90.9
pkgrel=1
source=(https://gitlab.freedesktop.org/$pkgname/$pkgname/-/archive/v$pkgver/$pkgname-v$pkgver.tar.bz2
        rules)
backup=(etc/UPower/UPower.conf)

build() {
	cd $pkgname-v$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D gtk-doc=false \
        -D man=true \
        -D systemdsystemunitdir=no \
        -D udevrulesdir=/usr/lib/udev/rules.d \
        build
	ninja -C build
}

package() {
    cd $pkgname-v$pkgver

	DESTDIR="$pkgdir" ninja -C build install

	install -Dm 644 "$srcdir"/rules "$pkgdir"/usr/share/polkit-1/rules.d/org.freedesktop.upower.rules
}