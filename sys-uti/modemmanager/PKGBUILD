# description	: Modem and mobile broadband management libraries
# depends	: libgudev glib udev gobject-introspection libqmi 
# depends	: libmbim polkit vala elogind

pkgname=modemmanager
_pkgname=ModemManager
pkgver=1.24.2
pkgrel=1
source=(https://gitlab.freedesktop.org/mobile-broadband/ModemManager/-/archive/$pkgver/ModemManager-$pkgver.tar.gz)

build() {
	cd $_pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        -D man=false  \
        -D qrtr=false \
        -D systemdsystemunitdir=no \
        build
	ninja -C build
    DESTDIR="$pkgdir" ninja -C build install
}
