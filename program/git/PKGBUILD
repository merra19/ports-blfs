# description	: Stupid content tracker: distributed VCS designed for speed and efficiency
# depends	: curl gnupg pcre2 openssl zlib libsecret glib tk fcron
# depends	: py3-asciidoc openssh pam udev xmlto

pkgname=git
pkgver=2.50.1
pkgrel=1
source=(https://www.kernel.org/pub/software/scm/git/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	./configure \
        --prefix=/usr \
		--with-gitconfig=/etc/gitconfig \
		--with-python=python3
	make
}

package() {
	cd $pkgname-$pkgver

	make DESTDIR="$pkgdir" perllibdir=/usr/lib/perl5/5.38/site_perl install

    # bash completion
    mkdir -p "$pkgdir"/usr/share/bash-completion/completions/
    install -m 0644 ./contrib/completion/git-completion.bash "$pkgdir"/usr/share/bash-completion/completions/git
}