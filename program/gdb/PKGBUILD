# description	: GNU debugger
# depends	: bash expat gcc glibc libgmp elfutils xz libmpfr ncurses
# depends	: readline zstd python3 boost texinfo py3-six zlib bison

pkgname=gdb
pkgver=16.3
pkgrel=1
source=(https://ftp.gnu.org/gnu/gdb/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	mkdir build
	cd    build

	../configure \
		--prefix=/usr \
		--with-system-readline \
		--with-system-zlib \
		--with-python=/usr/bin/python3
	make
}

package() {
	cd $pkgname-$pkgver/build

	make DESTDIR="$pkgdir" -C gdb install
	make DESTDIR="$pkgdir" -C gdbserver install
}