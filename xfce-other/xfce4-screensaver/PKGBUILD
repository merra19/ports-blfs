# description	: Screen saver and locker (port of MATE screensaver)
# depends	: libxscrnsaver libxklavier libwnck3 garcon dbus-glib
# depends	: python3 py3-gobject3 glib xfce4-dev-tools

pkgname=xfce4-screensaver
pkgver=4.20.0
pkgrel=1
source=(https://archive.xfce.org/src/apps/xfce4-screensaver/${pkgver%.*}/$pkgname-$pkgver.tar.xz)

prepare() {
  cd $pkgname-$pkgver
  
  NOCONFIGURE=1 ./autogen.sh
}

build() {
	cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libexecdir=/usr/lib \
        --localstatedir=/var \
        --disable-static \
        --disable-debug \
        --enable-maintainer-mode
    make
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" install
}
