# description	: X.Org X11 library
# depends	: libxcb-32 xtrans xorg-proto libx11

pkgname=libx11-32
_pkgname=libX11
pkgver=1.8.12
pkgrel=1
source=(https://www.x.org/pub/individual/lib/libX11-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver
    
	export CC="gcc -m32 -mstackrealign"
	export CXX="g++ -m32 -mstackrealign"
	export PKG_CONFIG_PATH="/usr/lib32/pkgconfig"

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --host=i686-pc-linux-gnu
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$PWD"/DESTDIR install
    mkdir -p "$pkgdir"/usr/lib32
    cp -Rv DESTDIR/usr/lib32/* "$pkgdir"/usr/lib32

    rm -f "$pkgdir"/usr/lib32/*.la
}