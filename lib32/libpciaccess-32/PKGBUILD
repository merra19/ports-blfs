# description	: Library providing generic access to the PCI bus and devices
# depends	: zlib-32 libpciaccess

pkgname=libpciaccess-32
_pkgname=libpciaccess
pkgver=0.18.1
pkgrel=1
source=(https://www.x.org/pub/individual/lib/libpciaccess-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

	export CC="gcc -m32 -mstackrealign"
	export CXX="g++ -m32 -mstackrealign"
	export PKG_CONFIG_PATH="/usr/lib32/pkgconfig"

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        --libdir=/usr/lib32 \
        build32
	ninja -C build32
}

package() {
    cd ${_pkgname}-$pkgver

    DESTDIR="$PWD"/DESTDIR ninja -C build32 install
    mkdir -p "$pkgdir"/usr/lib32
    cp -Rv DESTDIR/usr/lib32/* "$pkgdir"/usr/lib32
}