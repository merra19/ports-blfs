# description	: X.Org Xrandr library
# depends	: libx11-32 libxfixes-32 libxrender-32 libxext-32 
# depends	: xorg-proto libxrandr

pkgname=libxrandr-32
_pkgname=libXrandr
pkgver=1.5.4
pkgrel=1
source=(https://www.x.org/pub/individual/lib/libXrandr-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

	export CC="gcc -m32 -mstackrealign"
	export CXX="g++ -m32 -mstackrealign"
	export PKG_CONFIG_PATH="/usr/lib32/pkgconfig"

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --host=i686-pc-linux-gnu
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$PWD"/DESTDIR install
    mkdir -p "$pkgdir"/usr/lib32
    cp -Rv DESTDIR/usr/lib32/* "$pkgdir"/usr/lib32
}