# description	: Breeze visual style for the Plasma desktop
# depends	: breeze-icons frameworkintegration kcmutils kconfig 
# depends	: kconfigwidgets kcoreaddons kguiaddons ki18n cmake
# depends	: kiconthemes kirigami kwidgetsaddons kwindowsystem 
# depends	: kdecoration hicolor-icon-theme qt6-base qt6-declarative

pkgname=breeze
pkgver=6.4.4
pkgrel=1
source=(https://download.kde.org/stable/plasma/$pkgver/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

    cmake -B build \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_BUILD_TYPE=Release \
        -D BUILD_QT5=OFF \
        -D BUILD_TESTING=OFF \
        -Wno-dev
    make -C build
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" -C build install
}
