# description	: Plugin-based system monitoring daemon
# depends	: libnl kcoreaddons kdbusaddons ki18n kio solid 
# depends	: libksysguard libpcap lm-sensors qt6-base libcap 
# depends	: extra-cmake-modules
# optional	: networkmanager!!networkmanager-qt

pkgname=ksystemstats
pkgver=6.4.4
pkgrel=1
source=(https://download.kde.org/stable/plasma/$pkgver/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver
    
    cmake -B build \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_LIBEXECDIR=libexec \
        -D CMAKE_BUILD_TYPE=Release \
        -D BUILD_TESTING=OFF \
        -D CMAKE_DISABLE_FIND_PACKAGE_KF6NetworkManagerQt="$(scratch isinstalled networkmanager-qt && echo "OFF" || echo "ON")" \
        -Wno-dev
    make -C build
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" -C build install

    rm -rf "$pkgdir"/usr/lib/systemd
}