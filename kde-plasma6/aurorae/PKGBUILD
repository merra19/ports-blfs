# description	: Themeable window decoration for KWin
# depends	: kcmutils kcolorscheme kconfig kcoreaddons kdecoration
# depends	: ki18n kirigami knewstuff kpackage ksvg qt6-base
# depends	: qt6-declarative qt6-tools extra-cmake-modules

pkgname=aurorae
pkgver=6.4.4
pkgrel=1
source=(https://download.kde.org/stable/plasma/$pkgver/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

    cmake -B build \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_LIBEXECDIR=libexec \
        -D CMAKE_BUILD_TYPE=Release \
        -D BUILD_TESTING=OFF \
        -Wno-dev
    make -C build
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" -C build install
}