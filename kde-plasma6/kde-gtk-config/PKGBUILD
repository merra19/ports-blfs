# description	: Syncs KDE Plasma theme settings to GTK applications
# depends	: glib gsettings-desktop-schemas kcolorscheme kconfig 
# depends	: kcoreaddons kdbusaddons kguiaddons kwindowsystem cmake
# depends	: gtk3 sassc qt6-base qt6-svg
# todo      : xsettingsd

pkgname=kde-gtk-config
pkgver=6.4.4
pkgrel=1
source=(https://download.kde.org/stable/plasma/$pkgver/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver
    
    cmake -B build \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_LIBEXECDIR=libexec \
        -D CMAKE_BUILD_TYPE=Release \
        -D BUILD_TESTING=OFF \
        -Wno-dev
    make -C build
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" -C build install
}
