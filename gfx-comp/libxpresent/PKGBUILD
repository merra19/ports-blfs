# description	: X Present Extension C Library
# depends	: libx11 libxext libxfixes libxrandr xorg-proto

pkgname=libxpresent
_pkgname=libXpresent
pkgver=1.0.1
pkgrel=1
source=( https://www.x.org/pub/individual/lib/libXpresent-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/libXpresent-$pkgver
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$pkgdir" install
}