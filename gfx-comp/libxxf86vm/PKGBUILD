# description	: X.Org Xxf86vm library
# depends	: libx11 libxext xorg-proto

pkgname=libxxf86vm
_pkgname=libXxf86vm
pkgver=1.1.6
pkgrel=1
source=(https://www.x.org/pub/individual/lib/libXxf86vm-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/libXxf86vm-$pkgver
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$pkgdir" install
}