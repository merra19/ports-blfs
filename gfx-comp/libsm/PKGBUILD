# description	: X.Org Session Management library
# depends	: libice util-linux xtrans xorg-proto

pkgname=libsm
_pkgname=libSM
pkgver=1.2.6
pkgrel=1
source=(https://www.x.org/pub/individual/lib/libSM-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/$pkgname-$pkgver
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$pkgdir" install
}