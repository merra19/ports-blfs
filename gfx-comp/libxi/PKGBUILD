# description	: X.Org Xi library
# depends	: libx11 libxext libxfixes xorg-proto

pkgname=libxi
_pkgname=libXi
pkgver=1.8.2
pkgrel=1
source=( https://www.x.org/pub/individual/lib/libXi-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/libXi-$pkgver
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$pkgdir" install
}