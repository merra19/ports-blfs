# description	: X.Org Xext library
# depends	: libx11 xorg-proto

pkgname=libxext
_pkgname=libXext
pkgver=1.3.6
pkgrel=1
source=(https://www.x.org/pub/individual/lib/libXext-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/libXext-$pkgver
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$pkgdir" install
}