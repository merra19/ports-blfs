# description	: X.Org Xfixes library
# depends	: libx11 xorg-proto

pkgname=libxfixes
_pkgname=libXfixes
pkgver=6.0.1
pkgrel=1
source=(https://www.x.org/pub/individual/lib/libXfixes-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/libXfixes-$pkgver
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$pkgdir" install
}