# description	: X.Org Inter-Client Exchange library
# depends	: xorg-proto xtrans

pkgname=libice
_pkgname=libICE
pkgver=1.1.2
pkgrel=1
source=( https://www.x.org/pub/individual/lib/libICE-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/libICE-$pkgver
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir"/usr/lib/*.la
}