# description	: X.Org Xlib-based client API for the XTEST & RECORD extensions library
# depends	: libxext libxi libx11 xorg-proto

pkgname=libxtst
_pkgname=libXtst
pkgver=1.2.5
pkgrel=1
source=(https://www.x.org/pub/individual/lib/libXtst-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/libXtst-$pkgver
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$pkgdir" install
}