# description	: X.Org bdftopcf application (Xorg Legacy)
# depends	: util-macros xorg-proto

pkgname=bdftopcf
pkgver=1.1.1
pkgrel=1
source=(https://www.x.org/pub/individual/util/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

	./configure \
		--prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static
	make
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" install
}