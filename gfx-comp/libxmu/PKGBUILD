# description	: X.Org Xmu library
# depends	: libx11 libxt libxext xorg-proto

pkgname=libxmu
_pkgname=libXmu
pkgver=1.2.1
pkgrel=1
source=(https://www.x.org/pub/individual/lib/libXmu-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/libXmu-$pkgver
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$pkgdir" install
}