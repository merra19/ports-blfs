# description	: X.Org xtrans library
# depends	: glibc

pkgname=xtrans
pkgver=1.6.0
pkgrel=1
source=(https://www.x.org/pub/individual/lib/$pkgname-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/$pkgname-$pkgver
    make
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" install
}