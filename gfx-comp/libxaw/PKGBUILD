# description	: X.Org Xaw library
# depends	: libxmu libxpm libx11 libxext libxt xorg-proto

pkgname=libxaw
_pkgname=libXaw
pkgver=1.0.16
pkgrel=1
source=(https://www.x.org/pub/individual/lib/libXaw-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/libXaw-$pkgver
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$pkgdir" install
}