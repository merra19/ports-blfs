# description	: X.Org Xinerama library
# depends	: libx11 libxext xorg-proto

pkgname=libxinerama
_pkgname=libXinerama
pkgver=1.1.5
pkgrel=1
source=(https://www.x.org/pub/individual/lib/libXinerama-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/libXinerama-$pkgver
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$pkgdir" install
}
