# description	: X.Org Xfont library
# depends	: glibc zlib libxcb bzip2 xtrans libfontenc xorg-proto 
# depends	: freetype

pkgname=libxfont2
_pkgname=libXfont2
pkgver=2.0.7
pkgrel=1
source=(https://www.x.org/pub/individual/lib/libXfont2-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/libXfont2-$pkgver \
        --disable-devel-docs
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$pkgdir" install
}