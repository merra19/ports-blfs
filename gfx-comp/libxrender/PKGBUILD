# description	: X.Org Xrender library
# depends	: libx11 xorg-proto

pkgname=libxrender
_pkgname=libXrender
pkgver=0.9.12
pkgrel=1
source=( https://www.x.org/pub/individual/lib/libXrender-$pkgver.tar.xz)

build() {
    cd ${_pkgname}-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --docdir=/usr/share/doc/libXrender-$pkgver
    make
}

package() {
    cd ${_pkgname}-$pkgver

    make DESTDIR="$pkgdir" install
}