# description	: Library providing generic access to the PCI bus and devices
# depends	: zlib

pkgname=libpciaccess
pkgver=0.18.1
pkgrel=1
source=(https://www.x.org/pub/individual/lib/libpciaccess-$pkgver.tar.xz)

build() {
    cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

    DESTDIR="$pkgdir" ninja -C build install
}