# description	: Add-ons for the Kirigami framework
# depends	: extra-cmake-modules ki18n kirigami qt6-base cmake
# depends	: qt6-declarative sound-theme-freedesktop

pkgname=kirigami-addons
pkgver=1.9.0
pkgrel=1
source=(https://download.kde.org/stable/kirigami-addons/$pkgname-$pkgver.tar.xz)

build() {
	cd $pkgname-$pkgver

    cmake -B build \ -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_BUILD_TYPE=Release \
        -D BUILD_TESTING=OFF \
        -Wno-dev
    make -C build
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" -C build install
}