# description	: KDE's terminal emulator
# depends	: icu kbookmarks kconfig kconfigwidgets kcoreaddons cmake
# depends	: kcrash kdbusaddons kglobalaccel kguiaddons ki18n 
# depends	: kiconthemes kio kjobwidgets knewstuff kservice
# depends	: knotifications knotifyconfig kparts kpty kxmlgui
# depends	: ktextwidgets kwidgetsaddons kwindowsystem qt6-5compat
# depends	: qt6-base qt6-multimedia

pkgname=konsole
pkgver=25.08.0
pkgrel=1
source=(https://download.kde.org/stable/release-service/$pkgver/src/$pkgname-$pkgver.tar.xz
        https://www.linuxfromscratch.org/patches/blfs/svn/konsole-adjust_scrollbar-1.patch)

build() {
	cd $pkgname-$pkgver

    patch -Np1 -i ../konsole-adjust_scrollbar-1.patch

    cmake -B build \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_BUILD_TYPE=Release \
        -D BUILD_TESTING=OFF \
        -Wno-dev
    make -C build
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" -C build install
}