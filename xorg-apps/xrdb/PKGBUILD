# description	: X server resource database utility
# depends	: libx11 libxmu xorg-proto

pkgname=xrdb
pkgver=1.2.2
pkgrel=1
source=(https://www.x.org/pub/individual/app/$pkgname-$pkgver.tar.xz)


build() {
	cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static
    make
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" install
}
