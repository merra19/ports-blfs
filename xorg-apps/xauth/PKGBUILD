# description	: X authority file utility
# depends	: libx11 libxau libxext libxmu xorg-proto

pkgname=xauth
pkgver=1.1.4
pkgrel=1
source=(https://www.x.org/pub/individual/app/$pkgname-$pkgver.tar.xz)


build() {
	cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --enable-ipv6
    make
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" install
}