# description	: XKB keyboard description compiler
# depends	: libx11 libxkbfile xorg-proto

pkgname=xkbcomp
pkgver=1.4.7
pkgrel=1
source=(https://www.x.org/pub/individual/app/$pkgname-$pkgver.tar.xz)


build() {
	cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static
    make
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" install
}