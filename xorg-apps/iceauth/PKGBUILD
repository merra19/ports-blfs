# description	: ICE authority file utility
# depends	: libice xorg-proto

pkgname=iceauth
pkgver=1.0.10
pkgrel=1
source=(https://www.x.org/pub/individual/app/$pkgname-$pkgver.tar.xz)


build() {
	cd $pkgname-$pkgver

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static
    make
}

package() {
    cd $pkgname-$pkgver

    make DESTDIR="$pkgdir" install
}