# description	: VDPAU wrapper and trace libraries
# depends	: meson libx11 libxext xorg-proto

pkgname=libvdpau
pkgver=1.5
pkgrel=1
source=(https://gitlab.freedesktop.org/vdpau/libvdpau/-/archive/$pkgver/$pkgname-$pkgver.tar.bz2)

build() {
    cd $pkgname-$pkgver

	meson setup \
        --prefix=/usr \
        --buildtype=plain \
        build
	ninja -C build
}

package() {
    cd $pkgname-$pkgver

    DESTDIR="$pkgdir" ninja -C build install
}